# --- Sanity (required) ---
NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" # Optional - defaults to http://localhost:3334
SANITY_API_READ_TOKEN="<paste your token here>" # Required - The read token for your Sanity project

# --- Claude assistant (optional — powers the AI assistant in the Studio) ---
ANTHROPIC_API_KEY="" # Required for /api/claude routes - https://console.anthropic.com/
ALLOWED_CORS_ORIGINS="" # Optional - comma-separated origins allowed to call the Claude API routes (defaults to * in dev)

# --- Remote Claude API (optional — programmatic content creation endpoint) ---
CLAUDE_REMOTE_API_SECRET="" # Required to enable /api/claude/remote - shared secret for callers
CLAUDE_REMOTE_RATE_LIMIT="" # Optional - requests per minute (defaults to 30)
SANITY_API_TOKEN="" # Required for /api/claude/remote and Figma export - write token
SANITY_PROJECT_ID="" # Optional - falls back to NEXT_PUBLIC_SANITY_PROJECT_ID
SANITY_DATASET="" # Optional - falls back to NEXT_PUBLIC_SANITY_DATASET

# --- Figma integration (optional — import designs as page layouts) ---
FIGMA_ACCESS_TOKEN="" # Required for /api/figma routes - https://www.figma.com/developers/api#access-tokens
